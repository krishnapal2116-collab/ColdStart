{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldstart:report:1.0",
  "title": "ColdStart Report Schema 1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "tool",
    "invocation",
    "repository",
    "detection",
    "findings",
    "policy",
    "verification",
    "redaction",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool": { "$ref": "#/$defs/tool" },
    "invocation": { "$ref": "#/$defs/invocation" },
    "repository": { "$ref": "#/$defs/repository" },
    "detection": { "$ref": "#/$defs/detection" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "policy": { "$ref": "#/$defs/policy" },
    "verification": { "$ref": "#/$defs/verification" },
    "redaction": { "$ref": "#/$defs/redaction" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "catalog_version"],
      "properties": {
        "name": { "const": "coldstart" },
        "version": { "type": "string", "minLength": 1 },
        "catalog_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "invocation": {
      "type": "object",
      "required": ["command", "format", "strict", "limits"],
      "properties": {
        "command": { "type": "string" },
        "format": { "enum": ["terminal", "json"] },
        "strict": { "type": "boolean" },
        "config_path": { "type": ["string", "null"] },
        "limits": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": ["label", "boundary"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "boundary": { "type": "object", "additionalProperties": true },
        "scan_digest": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "detection": {
      "type": "object",
      "required": ["candidates", "applicability"],
      "properties": {
        "candidates": { "type": "array" },
        "applicability": { "type": "array" }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "check_id",
        "severity",
        "status",
        "title",
        "message",
        "evidence",
        "remediation",
        "affected_path",
        "category",
        "applicability",
        "rule_version"
      ],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error", "blocking"] },
        "status": { "enum": ["passed", "failed", "not_applicable", "skipped", "not_verified", "error"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "remediation": { "type": ["array", "string", "null"] },
        "affected_path": { "type": ["string", "null"] },
        "category": { "enum": ["project", "dependencies", "runtime", "documentation", "configuration", "portability", "security", "build", "execution"] },
        "applicability": { "$ref": "#/$defs/applicability" },
        "rule_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "path", "detail"],
      "properties": {
        "kind": { "enum": ["file", "directory", "metadata", "command", "absence", "execution", "policy", "error"] },
        "path": { "type": ["string", "null"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "detail": { "type": "string" },
        "digest": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "applicability": {
      "type": "object",
      "required": ["applicable", "reason", "adapter"],
      "properties": {
        "applicable": { "type": "boolean" },
        "reason": { "type": "string" },
        "adapter": { "type": "string" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["name", "decision", "treat_not_verified_as", "violations"],
      "properties": {
        "name": { "type": "string" },
        "decision": { "enum": ["pass", "needs_attention", "incomplete", "error"] },
        "treat_not_verified_as": { "enum": ["allow", "review", "fail"] },
        "violations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["requested", "authorized", "executions"],
      "properties": {
        "requested": { "type": "array", "items": { "type": "string" } },
        "authorized": { "type": "array", "items": { "type": "string" } },
        "executions": { "type": "array", "items": { "$ref": "#/$defs/execution" } }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["execution_id", "kind", "status", "authorization", "cleanup"],
      "properties": {
        "execution_id": { "type": "string" },
        "kind": { "enum": ["tests", "docker_build"] },
        "status": { "type": "string" },
        "authorization": { "type": "string" },
        "cleanup": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "network_mode": { "type": "string" }
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["mode", "redacted_count"],
      "properties": {
        "mode": { "type": "string" },
        "redacted_count": { "type": "integer", "minimum": 0 },
        "omitted_fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["overall", "counts"],
      "properties": {
        "overall": { "enum": ["pass", "needs_attention", "incomplete", "error"] },
        "counts": {
          "type": "object",
          "required": ["passed", "failed", "not_applicable", "skipped", "not_verified", "error"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "not_applicable": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "not_verified": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
