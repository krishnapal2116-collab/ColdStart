{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldstart:report:1.0",
  "title": "ColdStart Report Schema 1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "tool",
    "invocation",
    "repository",
    "detection",
    "findings",
    "policy",
    "verification",
    "redaction",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool": { "$ref": "#/$defs/tool" },
    "invocation": { "$ref": "#/$defs/invocation" },
    "repository": { "$ref": "#/$defs/repository" },
    "detection": { "$ref": "#/$defs/detection" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "policy": { "$ref": "#/$defs/policy" },
    "verification": { "$ref": "#/$defs/verification" },
    "redaction": { "$ref": "#/$defs/redaction" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "catalog_version"],
      "properties": {
        "name": { "const": "coldstart" },
        "version": { "type": "string", "minLength": 1 },
        "catalog_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "invocation": {
      "type": "object",
      "required": ["command", "format", "strict", "limits"],
      "properties": {
        "command": { "type": "string" },
        "format": { "enum": ["terminal", "json"] },
        "strict": { "type": "boolean" },
        "profile": { "type": ["string", "null"] },
        "config_path": { "type": ["string", "null"] },
        "limits": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": ["label", "boundary", "audit_fingerprint"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "boundary": { "type": "object", "additionalProperties": true },
        "audit_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scan_digest": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "detection": {
      "type": "object",
      "required": ["candidates", "applicability"],
      "properties": {
        "candidates": { "type": "array" },
        "applicability": { "type": "array" }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "check_id",
        "severity",
        "status",
        "title",
        "message",
        "evidence",
        "remediation",
        "affected_path",
        "category",
        "applicability",
        "rule_version",
        "evidence_strength"
      ],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error", "blocking"] },
        "status": { "enum": ["passed", "failed", "not_applicable", "skipped", "not_verified", "error"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "remediation": { "type": ["array", "string", "null"] },
        "affected_path": { "type": ["string", "null"] },
        "category": { "enum": ["project", "dependencies", "runtime", "documentation", "configuration", "portability", "security", "build", "execution"] },
        "applicability": { "$ref": "#/$defs/applicability" },
        "rule_version": { "type": "string", "minLength": 1 },
        "evidence_strength": { "enum": ["direct", "derived", "indicator", "absence", "unverified"] }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "path", "detail"],
      "properties": {
        "kind": { "enum": ["file", "directory", "metadata", "command", "absence", "execution", "policy", "error"] },
        "path": { "type": ["string", "null"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "detail": { "type": "string" },
        "digest": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "applicability": {
      "type": "object",
      "required": ["applicable", "reason", "adapter"],
      "properties": {
        "applicable": { "type": "boolean" },
        "reason": { "type": "string" },
        "adapter": { "type": "string" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["name", "decision", "treat_not_verified_as", "violations"],
      "properties": {
        "name": { "type": "string" },
        "decision": { "enum": ["pass", "needs_attention", "incomplete", "error"] },
        "treat_not_verified_as": { "enum": ["allow", "review", "fail"] },
        "violations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["requested", "authorized", "executions", "status"],
      "properties": {
        "requested": { "type": "array", "items": { "type": "string" } },
        "authorized": { "type": "array", "items": { "type": "string" } },
        "executions": { "type": "array", "items": { "$ref": "#/$defs/execution" } },
        "status": {
          "enum": [
            "not_requested",
            "planned",
            "denied",
            "passed",
            "failed",
            "not_verified",
            "unavailable",
            "timeout",
            "incomplete",
            "error"
          ]
        },
        "reason": { "type": ["string", "null"] },
        "plan": { "$ref": "#/$defs/execution_plan" }
      },
      "additionalProperties": true
    },
    "safe_command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "mount": {
      "type": "object",
      "required": ["source", "target", "read_only"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "read_only": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "resource_limits": {
      "type": "object",
      "properties": {
        "cpus": { "type": "string" },
        "memory": { "type": "string" },
        "pids_limit": { "type": "string" },
        "tmpfs": { "type": "string" }
      },
      "additionalProperties": true
    },
    "execution_plan": {
      "type": "object",
      "required": [
        "kind",
        "argv",
        "command",
        "working_directory",
        "working_directory_label",
        "network_mode",
        "offline",
        "runner",
        "isolation",
        "sandbox",
        "no_host_fallback",
        "host_fallback",
        "fallback_policy",
        "timeout_seconds",
        "output_limit_bytes"
      ],
      "properties": {
        "kind": { "enum": ["tests", "docker_build"] },
        "normalized_kind": { "enum": ["tests", "docker_build"] },
        "argv": { "$ref": "#/$defs/safe_command" },
        "command": { "$ref": "#/$defs/safe_command" },
        "display_argv": { "$ref": "#/$defs/safe_command" },
        "working_directory": { "type": "string" },
        "working_directory_label": { "type": "string" },
        "network_mode": { "enum": ["default", "none"] },
        "offline": { "type": "boolean" },
        "runner": { "enum": ["host", "docker"] },
        "runner_kind": { "enum": ["host", "docker"] },
        "isolation": { "enum": ["host", "docker"] },
        "isolation_mode": { "enum": ["host", "docker"] },
        "sandbox": { "enum": ["host", "docker"] },
        "image": { "type": ["string", "null"] },
        "repository_mount": { "$ref": "#/$defs/mount" },
        "resource_limits": { "$ref": "#/$defs/resource_limits" },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "output_limit_bytes": { "type": "integer", "minimum": 1 },
            "cpus": { "type": "string" },
            "memory": { "type": "string" },
            "pids_limit": { "type": "string" },
            "tmpfs": { "type": "string" }
          },
          "additionalProperties": true
        },
        "no_host_fallback": { "type": "boolean" },
        "host_fallback": { "type": "boolean" },
        "host_fallback_allowed": { "type": "boolean" },
        "fallback_policy": { "enum": ["none", "selected_runner_only"] },
        "fallback": { "enum": ["none", "selected_runner_only"] },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "output_limit_bytes": { "type": "integer", "minimum": 1 },
        "side_effect_notice": { "type": "string" },
        "candidate_source": { "type": "string" },
        "authorization_required": { "type": "boolean" },
        "requires_authorization": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "output_stream": {
      "type": "object",
      "required": ["digest", "bytes", "truncated", "detail"],
      "properties": {
        "digest": { "type": ["string", "null"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": true
    },
    "execution_output": {
      "type": "object",
      "required": ["limit_bytes", "bytes", "stdout", "stderr"],
      "properties": {
        "limit_bytes": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "stdout": { "$ref": "#/$defs/output_stream" },
        "stderr": { "$ref": "#/$defs/output_stream" }
      },
      "additionalProperties": true
    },
    "source_manifest": {
      "type": "object",
      "required": [
        "before",
        "after",
        "before_digest",
        "after_digest",
        "unchanged",
        "changed",
        "comparison"
      ],
      "properties": {
        "before": { "type": ["string", "null"] },
        "after": { "type": ["string", "null"] },
        "before_digest": { "type": ["string", "null"] },
        "after_digest": { "type": ["string", "null"] },
        "unchanged": { "type": ["boolean", "null"] },
        "changed": { "type": ["boolean", "null"] },
        "comparison": { "enum": ["not_checked", "unchanged", "changed", "error"] }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["execution_id", "kind", "status", "authorization", "cleanup_status"],
      "properties": {
        "execution_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["tests", "docker_build"] },
        "normalized_kind": { "enum": ["tests", "docker_build"] },
        "authorization": { "enum": ["authorized", "denied"] },
        "authorization_state": { "enum": ["authorized", "denied"] },
        "authorized": { "type": "boolean" },
        "executed": { "type": "boolean" },
        "status": {
          "enum": [
            "not_requested",
            "planned",
            "denied",
            "passed",
            "failed",
            "not_verified",
            "unavailable",
            "timeout",
            "incomplete",
            "error"
          ]
        },
        "result": {
          "enum": [
            "not_requested",
            "planned",
            "denied",
            "passed",
            "failed",
            "not_verified",
            "unavailable",
            "timeout",
            "incomplete",
            "error"
          ]
        },
        "outcome": {
          "enum": [
            "not_requested",
            "planned",
            "denied",
            "passed",
            "failed",
            "not_verified",
            "unavailable",
            "timeout",
            "incomplete",
            "error"
          ]
        },
        "candidate_source": { "type": "string" },
        "argv": { "$ref": "#/$defs/safe_command" },
        "command": { "$ref": "#/$defs/safe_command" },
        "working_directory": { "type": "string" },
        "working_directory_label": { "type": "string" },
        "network_mode": { "enum": ["default", "none"] },
        "runner": { "enum": ["host", "docker"] },
        "runner_kind": { "enum": ["host", "docker"] },
        "isolation": { "enum": ["host", "docker"] },
        "isolation_mode": { "enum": ["host", "docker"] },
        "sandbox": { "enum": ["host", "docker"] },
        "image": { "type": ["string", "null"] },
        "offline": { "type": "boolean" },
        "repository_mount": { "$ref": "#/$defs/mount" },
        "resource_limits": { "$ref": "#/$defs/resource_limits" },
        "no_host_fallback": { "type": "boolean" },
        "host_fallback": { "type": "boolean" },
        "host_fallback_allowed": { "type": "boolean" },
        "fallback_policy": { "enum": ["none", "selected_runner_only"] },
        "fallback": { "enum": ["none", "selected_runner_only"] },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "output_limit_bytes": { "type": "integer", "minimum": 1 },
        "limits": {
          "type": "object",
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "output_limit_bytes": { "type": "integer", "minimum": 1 },
            "cpus": { "type": "string" },
            "memory": { "type": "string" },
            "pids_limit": { "type": "string" },
            "tmpfs": { "type": "string" }
          },
          "additionalProperties": true
        },
        "exit_code": { "type": ["integer", "null"] },
        "observed_exit_code": { "type": ["integer", "null"] },
        "returncode": { "type": ["integer", "null"] },
        "termination_reason": { "type": ["string", "null"] },
        "termination": { "type": ["string", "null"] },
        "cleanup": { "enum": ["not_started", "completed", "failed"] },
        "cleanup_status": { "enum": ["not_started", "completed", "failed"] },
        "source_manifest": { "$ref": "#/$defs/source_manifest" },
        "source_manifest_before": { "type": ["string", "null"] },
        "source_manifest_after": { "type": ["string", "null"] },
        "source_manifest_unchanged": { "type": ["boolean", "null"] },
        "source_manifest_comparison": { "type": ["string", "null"] },
        "manifest_unchanged": { "type": ["boolean", "null"] },
        "source_unchanged": { "type": ["boolean", "null"] },
        "manifest_comparison": { "enum": ["not_checked", "unchanged", "changed", "error"] },
        "output": { "$ref": "#/$defs/execution_output" },
        "output_metadata": { "$ref": "#/$defs/execution_output" },
        "output_limits": { "$ref": "#/$defs/execution_output" },
        "stdout_digest": { "type": ["string", "null"] },
        "stderr_digest": { "type": ["string", "null"] },
        "stdout_bytes": { "type": "integer", "minimum": 0 },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 },
        "captured_output_bytes": { "type": "integer", "minimum": 0 },
        "total_output_bytes": { "type": "integer", "minimum": 0 },
        "stdout_truncated": { "type": "boolean" },
        "stderr_truncated": { "type": "boolean" },
        "stdout_detail": { "type": "string" },
        "stderr_detail": { "type": "string" },
        "reason": { "type": "string" },
        "limitation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["mode", "redacted_count"],
      "properties": {
        "mode": { "type": "string" },
        "redacted_count": { "type": "integer", "minimum": 0 },
        "omitted_fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["overall", "counts"],
      "properties": {
        "overall": { "enum": ["pass", "needs_attention", "incomplete", "error"] },
        "counts": {
          "type": "object",
          "required": ["passed", "failed", "not_applicable", "skipped", "not_verified", "error"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "not_applicable": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "not_verified": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
