{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coldstart:report:1.0",
  "title": "ColdStart Report Contract 1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_id",
    "tool",
    "input",
    "project",
    "checks",
    "policy",
    "verification",
    "redaction",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "coldstart" },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string" }
      },
      "additionalProperties": true
    },
    "input": {
      "type": "object",
      "required": ["project_root", "options", "boundary"],
      "properties": {
        "project_root": { "type": "string", "minLength": 1 },
        "project_label": { "type": "string" },
        "options": { "type": "object", "additionalProperties": true },
        "boundary": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["ecosystems", "confidence", "adapter_coverage"],
      "properties": {
        "ecosystems": { "type": "array" },
        "confidence": { "type": "string" },
        "adapter_coverage": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "version",
        "category",
        "title",
        "status",
        "severity",
        "summary",
        "evidence",
        "recommendations",
        "adapter"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["project", "runtime", "dependencies", "documentation", "build", "portability", "execution", "security"]
        },
        "title": { "type": "string" },
        "status": {
          "enum": ["passed", "failed", "not_verified", "skipped", "error"]
        },
        "severity": {
          "enum": ["info", "warning", "error", "blocking"]
        },
        "summary": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "adapter": { "type": "string" }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": ["file", "directory", "command", "metadata", "execution", "absence", "policy"]
        },
        "path": { "type": ["string", "null"] },
        "line_start": { "type": ["integer", "null"], "minimum": 1 },
        "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "detail": { "type": "string" },
        "digest": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["name", "violations", "decision"],
      "properties": {
        "name": { "type": "string" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "violations": { "type": "array", "items": { "type": "string" } },
        "decision": { "enum": ["pass", "fail", "review"] }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["requested", "authorized", "executions"],
      "properties": {
        "requested": { "type": "array", "items": { "type": "string" } },
        "authorized": { "type": "array", "items": { "type": "string" } },
        "executions": { "type": "array", "items": { "$ref": "#/$defs/execution" } }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["execution_id", "kind", "authorization", "cleanup"],
      "properties": {
        "execution_id": { "type": "string" },
        "kind": { "enum": ["tests", "docker_build"] },
        "authorization": { "type": "string" },
        "cleanup": { "type": "string" },
        "status": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "network_mode": { "type": "string" }
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string" },
        "secret_values_redacted": { "type": "integer", "minimum": 0 },
        "omitted_fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["overall", "counts"],
      "properties": {
        "overall": { "enum": ["pass", "needs_attention", "not_verified", "error"] },
        "counts": {
          "type": "object",
          "required": ["passed", "failed", "not_verified", "skipped", "error"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "not_verified": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
